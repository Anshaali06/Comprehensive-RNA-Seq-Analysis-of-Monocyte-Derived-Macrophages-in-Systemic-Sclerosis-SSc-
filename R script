# 1. Load required package
library(DESeq2)

# 2. Read gene count file
counts <- read.delim(
  "gene_counts.txt",
  comment.char = "#",
  check.names = FALSE
)

# 3. Check dimensions
dim(counts)

# 4. Create count matrix
count_matrix <- counts[, c(1, 7:12)]

# Check dimensions
dim(count_matrix)

# 5. 
colnames(count_matrix)[-1] <- sub(
  "_sorted\\.bam$",
  "",
  basename(colnames(count_matrix)[-1])
)


# Gene IDs  row name 
rownames(count_matrix) <- count_matrix[, 1]

# Gene ID column remove 
count_matrix <- count_matrix[, -1]
# Check
dim(count_matrix)
colnames(count_matrix)

# 8. Create sample information
sample_info <- data.frame(
  condition = factor(
    c("MDM", "MDM", "MDM",
      "Control", "Control", "Control")
  )
)

rownames(sample_info) <- colnames(count_matrix)

# Check sample information
sample_info

# 9. Create DESeq2 object
dds <- DESeqDataSetFromMatrix(
  countData = count_matrix,
  colData = sample_info,
  design = ~ condition
)
dds

# 10. Low-count filtering
keep <- rowSums(counts(dds) >= 10) >= 3
dds <- dds[keep, ]

# Check dimensions after filtering
dim(dds)

# 11. Run DESeq2
dds <- DESeq(dds)

# 12. Obtain differential expression results
res <- results(dds)

# 13. View results
head(res)

# 14. Summary of DEGs
summary(res)

# 15. Check result columns
colnames(res)

# 16. Select significant genes
sig <- res[!is.na(res$padj) & res$padj < 0.1, ]

# 17. Separate upregulated genes
up <- sig[sig$log2FoldChange > 0, ]

# 18. Separate downregulated genes
down <- sig[sig$log2FoldChange < 0, ]

# 19. Count genes
nrow(sig)
nrow(up)
nrow(down)
