#PCA Plot
library(ggplot2)

pcaData <- plotPCA(
  vsd,
  intgroup = "condition",
  returnData = TRUE
)

ggplot(
  pcaData,
  aes(x = PC1, y = PC2, color = condition)
) +
  geom_point(size = 5) +

  geom_text(
    aes(label = name),
    vjust = -1,
    size = 3.5,
    show.legend = FALSE
  ) +

  scale_color_manual(
    values = c(
      "Control" = "red",
      "MDM" = "blue"
    )
  ) +

  scale_x_continuous(
    expand = expansion(mult = c(0.20, 0.30))
  ) +

  scale_y_continuous(
    expand = expansion(mult = c(0.20, 0.30))
  ) +

  labs(
    title = "PCA Plot: MDM vs Control",
    x = paste0(
      "PC1: ",
      round(
        100 * attr(pcaData, "percentVar")[1],
        1
      ),
      "% variance"
    ),
    y = paste0(
      "PC2: ",
      round(
        100 * attr(pcaData, "percentVar")[2],
        1
      ),
      "% variance"
    ),
    color = "Condition"
  ) +

  theme_minimal(base_size = 13) +

  theme(
    plot.title = element_text(
      size = 16,
      face = "bold",
      hjust = 0.5
    ),
    legend.position = "right",
    plot.margin = margin(
      20, 40, 20, 40
    )
  )

Heatmap -Top 50 DEGs
library(pheatmap)

top_genes <- rownames(
  res[order(res$padj, na.last = NA), ]
)[1:50]

vsd <- vst(
  dds,
  blind = FALSE
)

mat <- assay(vsd)[top_genes, ]

mat <- mat - rowMeans(mat)

annotation_col <- data.frame(
  Condition = colData(dds)$condition
)

rownames(annotation_col) <- colnames(dds)

pheatmap(
  mat,
  cluster_rows = TRUE,
  cluster_cols = TRUE,
  show_rownames = FALSE,
  show_colnames = TRUE,
  annotation_col = annotation_col,
  main = "Top 50 DEGs: MDM vs Control",
  fontsize = 10,
  border_color = NA
)




